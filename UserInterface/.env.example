# ==============================================================================
# VIEW TUBE FRONTEND - ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to `.env` inside the `UserInterface/` directory.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BASE URL & PROVIDER
# ------------------------------------------------------------------------------
VITE_API_BASE=/api/v1
VITE_AUTH_PROVIDER=mongodb

# ------------------------------------------------------------------------------
# 2. FIREBASE WEB CLIENT SDK (Required for Google Sign-in)
# ------------------------------------------------------------------------------
# Get these values from Firebase Console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional Firebase Config (Safe to keep if available)
VITE_FB_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FB_MEASUREMENT_ID=G-XXXXXXXXXX
