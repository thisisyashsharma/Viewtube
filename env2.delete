# Server
PORT=8000
NODE_ENV=development

# MongoDB (Atlas SRV or local)
MONGODB_URI=mongodb+srv://testing_db:testing_db@cluster0.bvvssur.mongodb.net/
DB_NAME=viewtube

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT — use the same names your model/middleware expect
ACCESS_TOKEN_SECRET=supersecretkey
ACCESS_TOKEN_EXPIRY=7d
REFRESH_TOKEN_SECRET=anothersecretkey
REFRESH_TOKEN_EXPIRY=30d


# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=viewtube

USE_CLOUDINARY=false

DEFAULT_STORAGE=local   # or local


