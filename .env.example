 
# 1. SERVER CONFIGURATION
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# 2. DATABASE CONFIGURATION (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
DB_NAME=viewtube

# 3. JWT AUTHENTICATION SECRETS
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=30d

# 4. FIREBASE ADMIN SDK (Required for Google Sign-in Verification)
# ------------------------------------------------------------------------------
# Download the service account JSON from Firebase Console -> Project Settings -> Service accounts
# Encode the JSON file to base64 string:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
#   Linux / Mac:        base64 -w 0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account_json_here

# 5. STORAGE CONFIGURATION
DEFAULT_STORAGE=local

# Cloudinary Storage Credentials (Optional - if DEFAULT_STORAGE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=viewtube

# Google Cloud Storage Credentials (Optional - if DEFAULT_STORAGE=gcs)
GCS_PROJECT_ID=your_gcs_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_KEY_FILE=./secrets/gcs-key.json

# User Storage Limits
USER_STORAGE_LIMIT_MB=100
ENABLE_VIDEO_COMPRESSION=false

# 6. SMTP EMAIL & OTP VERIFICATION (Optional - for Email Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="ViewTube <no-reply@viewtube.com>"
OTP_VALID_MINUTES=5
OTP_LENGTH=6

# ------------------------------------------------------------------------------
# 7. ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@viewtube.com
